# =============================================================================
# SnapBox Photobooth: contoh variabel lingkungan (PRD Bab 10.14)
#
# Cara pakai:
#   1. Next.js menyelesaikan file env relatif terhadap `apps/web/`, jadi web app
#      butuh `apps/web/.env.local` (bukan `.env.local` di root). File `.env` di
#      root tidak dibaca Next.js dan tidak dibaca `drizzle.config.ts` (yang
#      membaca `process.env` polos); gunanya hanya sumber manual untuk shell
#      operator, mis. `set -a; . ./.env; set +a` lalu
#      `pnpm migrate:ordered --db-url "$DIRECT_URL"`.
#   2. Isi nilainya dari dasbor masing-masing vendor.
#   3. JANGAN commit file berisi nilai asli. `.env*` sudah diabaikan Git.
#
# Aturan trust boundary:
#   - Hanya variabel berprefix `NEXT_PUBLIC_` (web) dan `VITE_` (desktop) yang
#     di-inline ke bundle browser/kiosk. Semua orang bisa membacanya.
#   - `NEXT_PUBLIC_` Firebase web config + Supabase anon key BUKAN secret.
#   - `SUPABASE_SERVICE_ROLE_KEY`, `FIREBASE_ADMIN_PRIVATE_KEY`, kredensial
#     pembayaran (Pakasir), dan semua kunci ENCRYPTION ADALAH secret server.
#   - Semua placeholder di bawah sengaja dibuat palsu (`replace-me-...`).
#     Nilai asli diambil dari dasbor vendor, bukan dari file ini.
#
# Berkas ini satu-satunya inventaris yang di-commit. `pnpm check:env-example`
# gagal kalau isinya menyimpang dari inventaris kode
# (`scripts/check-env-example.mjs` + `packages/shared/src/env.ts`).
#
# Status konsumen (Fase 0-1): nama berikut belum punya konsumen di repo ini,
# jadi jangan diasumsikan hidup: `PAIRING_TOKEN_SECRET`, `LAN_JWT_SECRET`,
# `DEVICE_JWT_SECRET`, `WHATSAPP_SALES_NUMBER`, `NEXT_PUBLIC_MIDTRANS_CLIENT_KEY`,
# =============================================================================

# ===== PUBLIC (di-inline ke bundle browser, bukan secret) =====
# Sumber: dasbor Supabase, Firebase Console, Midtrans, Cloudflare Turnstile,
#         Sentry. Scope: development | preview | production (nilai berbeda
#         per environment). Tidak ada generator khusus; salin dari vendor.
NEXT_PUBLIC_APP_URL=https://snapbox.id
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-supabase-anon-key
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=snapbox.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=snapbox
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxx:web:xxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-me-midtrans-client-key
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Nomor WhatsApp sales untuk CTA landing publik. Di-inline ke bundle browser.
# Format internasional, digit saja, tanpa tanda `+`. Kosong = CTA WhatsApp publik
# dirender dalam state disabled berlabel (bukan tautan mati).
NEXT_PUBLIC_SALES_WHATSAPP=replace-me-sales-whatsapp-digits

# ===== SERVER_ONLY (jangan pernah masuk bundle browser) =====
# Sumber: Supabase (service role + connection string), Firebase Console
#         (service account). Scope: development | preview | production.
# SUPABASE_SERVICE_ROLE_KEY dan FIREBASE_ADMIN_PRIVATE_KEY = SECRET.
SUPABASE_SERVICE_ROLE_KEY=replace-me-supabase-service-role-key
# Runtime: Supabase Session Pooler (port 5432). `prepare: false` di client
# mendukung pooler dan serverless.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres
# Drizzle generate/migrate/push/studio + seed: direct database connection.
DIRECT_URL=postgresql://postgres.xxx:password@db.xxx.supabase.co:5432/postgres
FIREBASE_ADMIN_PROJECT_ID=snapbox
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@snapbox.iam.gserviceaccount.com
# SECRET. Format PEM dengan newline ter-escape `\n` (loader di
# packages/auth/src/admin.ts melakukan `replace(/\\n/g, '\n')`).
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Signing key cookie sesi web (`snapbox_session`). SECRET. Dipakai server DAN
# edge middleware, jadi wajib tersedia di kedua runtime. Verifikasi HMAC
# memakai Web Crypto, sehingga kunci ini BUKAN bagian rombongan ENCRYPTION di
# bawah yang formatnya terikat helper `node:crypto`.
# Generator: openssl rand -base64 32
SESSION_COOKIE_SECRET=replace-me-openssl-rand-base64-32

# Kunci lama yang MASIH HARUS diterima saat verifikasi, dipisah koma. Ada supaya
# rotasi SESSION_COOKIE_SECRET tidak menjadi outage: pada deploy bergulir sebagian
# instance memegang kunci baru dan sebagian masih kunci lama. Kunci di sini hanya
# untuk MEMVERIFIKASI; cookie baru selalu ditandatangani SESSION_COOKIE_SECRET.
# Kosong = tidak ada kunci lama (nilai default yang benar).
# Prosedur rotasi dua langkah ada di docs/ENVIRONMENT-AND-SECRETS.md.
SESSION_COOKIE_SECRET_PREVIOUS=

# Opt-out `Secure` pada cookie sesi. HANYA untuk `http://localhost` saat
# pengembangan lokal. Sengaja bukan NODE_ENV: preview/staging sering menjalankan
# NODE_ENV=production di belakang hostname lain dan akan menerima cookie tanpa
# `Secure` yang bisa direplay lewat HTTP. Hanya nilai persis `1` yang menonaktifkan.
SESSION_COOKIE_INSECURE_DEV=

# ===== ENCRYPTION (SECRET server-only, tidak pernah dikirim ke mana pun) =====
# Sumber: dibuat lokal, disimpan di secret manager. Scope: berbeda per
# environment (development | preview | production) agar kunci produksi tidak bocor.
# Semua kunci wajib base64 dari tepat 32 byte acak (256-bit).
# Generator: openssl rand -base64 32
# Rotasi mengikuti PRD Bab 10.16 ADR-003 (per kuartal).
ENCRYPTION_MASTER_KEY=replace-me-openssl-rand-base64-32
PAIRING_TOKEN_SECRET=replace-me-openssl-rand-base64-32
LAN_JWT_SECRET=replace-me-openssl-rand-base64-32
DEVICE_JWT_SECRET=replace-me-openssl-rand-base64-32

# ===== THIRD_PARTY (server only, SECRET) =====
# Sumber: dasbor masing-masing vendor. Scope: development | preview | production.
# Generator: tidak ada; salin token dari dasbor vendor.
#   - Pakasir    : dasbor merchant (B2B) -> API key + webhook secret.
#   - Resend     : https://resend.com/api-keys -> API key + verified sender.
#   - Sentry     : dasbor Sentry -> Auth Token (token CI/upload source map),
#                  slug organisasi, dan slug project.
PAKASIR_B2B_API_KEY=replace-me-pakasir-b2b-api-key
PAKASIR_B2B_WEBHOOK_SECRET=replace-me-pakasir-b2b-webhook-secret
# Opsional (draft Task 1.6). Base URL API Pakasir B2B, WAJIB HTTPS, tanpa path
# endpoint. Kosong = adapter gagal tertutup dan tidak mengirim permintaan.
PAKASIR_B2B_API_URL=https://api-sandbox.pakasir.example
RESEND_API_KEY=replace-me-resend-api-key
RESEND_FROM_EMAIL="SnapBox <noreply@snapbox.id>"
# Penerima email dukungan owner. Dibaca `apps/web/src/lib/email/resend.ts`
# (`sendOwnerSupportEmail`). BUKAN secret.
# Kosong/tidak valid = pesan dukungan dibuang diam-diam dan tidak pernah dikirim,
# jadi WAJIB ada di setiap environment yang menyajikan halaman publik `/kontak`.
SUPPORT_EMAIL=replace-me-support-email
SENTRY_AUTH_TOKEN=replace-me-sentry-auth-token
SENTRY_ORG=snapbox
SENTRY_PROJECT=snapbox-web
# Build/CI saja, BUKAN secret. Dikonsumsi `apps/desktop/vite.config.ts`; CI
# mengisinya dari `github.ref_name` (`.github/workflows/tauri.yml`). Default
# lokal `dev`.
SENTRY_RELEASE=snapbox-web@0.1.0

# ===== TELEMETRY (server only, SECRET) =====
# Task 1.11. Production requirements: set all three values in the server
# runtime/secret manager. Missing values fail closed for WAF/heartbeat routes;
# telemetry writes remain best-effort and never grant access.
# TELEMETRY_HASH_SALT hashes IP/email before security_events storage; raw values
# are never stored. Generate: openssl rand -base64 32
TELEMETRY_HASH_SALT=replace-me-openssl-rand-base64-32
# WAF_INGEST_SECRET authenticates POST /api/internal/telemetry/waf. Empty = 503.
WAF_INGEST_SECRET=replace-me-openssl-rand-base64-32
# HEARTBEAT_SECRET authenticates POST /api/internal/telemetry/heartbeat. Empty = 503.
HEARTBEAT_SECRET=replace-me-openssl-rand-base64-32

# ===== CLOUDFLARE (server only, SECRET) =====
# Sumber: dasbor Cloudflare. Scope: development | preview | production.
#   - API Token: My Profile -> API Tokens (scoped, jangan Global API Key).
#   - Zone ID  : halaman overview zone domain.
#   - Turnstile Secret: Turnstile -> site -> Secret Key (pasangan dari
CLOUDFLARE_API_TOKEN=replace-me-cloudflare-api-token
CLOUDFLARE_ZONE_ID=replace-me-cloudflare-zone-id

# ===== LINKS (bukan secret) =====
# Sumber: nomor sales WhatsApp dalam format internasional tanpa tanda `+`.
# Scope: development | preview | production.
WHATSAPP_SALES_NUMBER=6281234567890

# ===== DESKTOP (Vite, bukan Next.js) =====
# Vite hanya meng-inline prefix VITE_, jadi NEXT_PUBLIC_* tidak terlihat di kiosk.
# VITE_* ikut ter-bundle ke aplikasi desktop -> perlakukan sebagai data publik.
# Sumber: dasbor Sentry (project desktop). Scope: development | production.
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
# Catatan: nilainya selalu ditimpa saat build oleh `define` di `vite.config.ts`
# dari `SENTRY_RELEASE ?? GITHUB_SHA ?? 'dev'`, jadi mengisinya di file env tidak
# berpengaruh. Tetap ada di inventaris sebagai jejak konfigurasi.
VITE_SENTRY_RELEASE=snapbox-desktop@0.1.0

# ===== CLI (sekali jalan, bukan variabel runtime) =====
# Dikonsumsi `firebase-admin-script/set-ceo.js` (script melempar error kalau
# kosong): akun yang menerima custom claim `app_role=CEO`. TIDAK dibaca runtime
# web dan TIDAK perlu ada di Vercel. Script ini TIDAK membaca `FIREBASE_ADMIN_*`:
# auth lewat `applicationDefault()` butuh `CEO_EMAIL` +
# `GOOGLE_APPLICATION_CREDENTIALS`, dan harus dijalankan dari direktori
# `firebase-admin-script/` (package.json-nya punya script `set-ceo`).
CEO_EMAIL=replace-me-ceo-email
# Kredensial ADC untuk `applicationDefault()` di `firebase-admin-script/set-ceo.js`.
# BUKAN env Next.js/Vercel: menunjuk file JSON service account di disk
# (`$HOME/.config/gcloud/...` atau path absolut). `FIREBASE_ADMIN_*` TIDAK dipakai
# script ini, jadi tanpa nilai ini `pnpm set-ceo` gagal.
GOOGLE_APPLICATION_CREDENTIALS=replace-me-path-ke-service-account-json
