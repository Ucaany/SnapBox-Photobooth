# pnpm memasang peer dependency otomatis. Dibutuhkan agar plugin ESLint
# (next, @typescript-eslint, react-hooks) yang dibawa eslint-config-next
# selalu punya pasangan versi yang cocok tanpa deklarasi manual per paket.
auto-install-peers=true

# Dedupe peer dependents agar plugin ESLint tidak terdaftar dua kali
# (ESLint 9 menolak plugin yang di-redefine dengan objek berbeda).
dedupe-peer-dependents=true
