{
  "name": "@snapbox/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SnapBox Desktop Kiosk (Tauri v2). Shell frontend saja di Task 0.1; hardware engine di Fase 4.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
