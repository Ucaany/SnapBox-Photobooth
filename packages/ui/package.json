{
  "name": "@snapbox/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Komponen UI neobrutalism SnapBox. Base component dibangun di Task 0.2.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/cn": "./src/lib/cn.ts",
    "./lib/utils": "./src/lib/cn.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles.css": "./src/styles.css",
    "./styles/marquee.css": "./src/styles/marquee.css"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.4.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.0.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.7.0"
  },
