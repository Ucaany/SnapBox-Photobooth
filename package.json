{
  "name": "snapbox",
  "version": "0.1.0",
  "private": true,
  "description": "SnapBox Photobooth: platform SaaS manajemen photobooth multi-tenant + kiosk desktop Tauri v2.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "supabase:db:reset": "supabase db reset",
    "prepare": "husky",
    "check:token-sync": "node scripts/check-token-sync.mjs",
    "check:firebase-project-id": "node scripts/check-firebase-project-id.mjs",
    "check:claims-sync": "node scripts/check-claims-sync.mjs",
    "check:infra-drafts": "node scripts/check-infra-drafts.mjs",
    "check:env-example": "node scripts/check-env-example.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
